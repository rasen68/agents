{
  "name": "pi-goal-x",
  "version": "0.32.3-local.1",
  "description": "Local pi-goal-x fork with a unified Alt+G goals screen and /goals entry point.",
  "license": "MIT",
  "author": "pi-goal-x contributors",
  "type": "module",
  "bin": {
    "pi-goal-x-recover": "scripts/recover-session-checkpoints.mjs"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "goal",
    "sisyphus",
    "autoresearch",
    "agent-loop",
    "long-running"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tmonk/pi-goal-x.git"
  },
  "homepage": "https://github.com/tmonk/pi-goal-x#readme",
  "bugs": {
    "url": "https://github.com/tmonk/pi-goal-x/issues"
  },
  "files": [
    "extensions",
    "scripts/recover-session-checkpoints.mjs",
    "README.md",
    "LICENSE",
    "docs/agent-flow-design.md",
    "docs/agentic-runtime-prd.md",
    "docs/architecture.md",
    "docs/prompt-caching.md",
    "docs/advanced-usage.md",
    "docs/pi-autoresearch-survey.md",
    "docs/pi-goal-x-unified-dashboard-plan.md",
    "docs/unified-dashboard.md",
    "assets/badge-light.svg",
    "assets/badge-dark.svg"
  ],
  "pi": {
    "extensions": [
      "extensions/goal.ts"
    ],
    "image": "https://github.com/tmonk/pi-goal-x/raw/main/pi-goal-x.png"
  },
  "scripts": {
    "check": "npm exec --yes --package typescript@5.9.3 -- tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:integration": "node --experimental-strip-types --test tests/extension-loader.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.83.0 <2.0.0",
    "@earendil-works/pi-coding-agent": ">=0.83.0 <2.0.0",
    "@earendil-works/pi-tui": ">=0.83.0 <2.0.0",
    "typebox": "^1.3.11"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@eslint/js": "^9.39.5",
    "@xterm/headless": "^6.0.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "typebox": "^1.3.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "undici": "8.10.0",
      "minimatch": "10.2.6"
    },
    "minimatch": {
      "brace-expansion": "5.0.9"
    }
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
